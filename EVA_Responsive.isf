        { "TARGET": "scene" },
        { "TARGET": "gA",    "WIDTH": "floor($WIDTH/4)", "HEIGHT": "floor($HEIGHT/4)", "FLOAT": true },
        { "TARGET": "gB",    "WIDTH": "floor($WIDTH/4)", "HEIGHT": "floor($HEIGHT/4)", "FLOAT": true },
        { }
